{
  "collapse-filter": false,
  "search": "-path:_review -path:.raw -path:assets -path:examples",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": true,
  "collapse-color-groups": true,
  "colorGroups": [
    {
