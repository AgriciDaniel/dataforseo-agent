  "collapse-display": true,
  "showArrow": true,
  "textFadeMultiplier": 0.1,
  "nodeSizeMultiplier": 1.3,
  "lineSizeMultiplier": 1.2,
  "collapse-forces": true,
  "centerStrength": 0.45,
  "repelStrength": 12,
  "linkStrength": 1,
  "linkDistance": 160,
  "scale": 1.5,
  "close": true
}