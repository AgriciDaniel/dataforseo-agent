        "rgb": 14926830
      }
    },
    {
      "query": "path:wiki/modules",
      "color": {
        "a": 1,
        "rgb": 3901174
      }
    },
    {
      "query": "path:wiki/workflows",
      "color": {
        "a": 1,
        "rgb": 5025616
      }
    },
    {
      "query": "path:wiki/cost OR path:wiki/platform",
      "color": {
        "a": 1,
        "rgb": 15172649
      }
    },
    {
      "query": "path:wiki/decisions",
      "color": {
        "a": 1,
        "rgb": 10233776
      }
    },
    {
      "query": "path:wiki/reference",
      "color": {
        "a": 1,
        "rgb": 16750592
      }
    },
    {
      "query": "path:wiki/flows OR path:wiki/meta",
      "color": {
        "a": 1,
        "rgb": 4149685
      }
    },
    {
      "query": "path:wiki/gaps OR path:wiki/questions OR path:wiki/experiments",
      "color": {
        "a": 1,
        "rgb": 9159498
      }
    },
    {
      "query": "path:wiki/sources",
      "color": {
        "a": 1,
        "rgb": 12434877
      }
    }
