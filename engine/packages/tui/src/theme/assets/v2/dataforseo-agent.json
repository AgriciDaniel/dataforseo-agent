        "300": "#3a76bd",
        "400": "#568cce",
        "500": "#74a3dc",
        "600": "#96bbe7",
        "700": "#b8d1f0",
        "800": "#d8e6f7",
        "900": "#f0f5fb"
      },
      "purple": {
        "100": "#6b47a7",
